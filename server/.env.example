# ============================================================
# waiter-api — серверные секреты. НИКОГДА не попадают в браузер.
# Скопируй в server/.env и заполни РОТИРОВАННЫМИ значениями.
# ============================================================

# Порт, на котором слушает сервис
PORT=8080

# Разрешённые источники (домены фронта), через запятую.
# Прод-пример: https://waiter.example.ru
# Если оставить пустым — разрешаются любые (только для локальной разработки!)
CORS_ORIGIN=

# --- Supabase (база официантов) ---
SUPABASE_WAITER_URL=
# SERVICE ROLE KEY — обходит RLS. Только здесь, на сервере!
SUPABASE_WAITER_SERVICE_KEY=
# Бакет для документов официантов
WAITER_DOCUMENTS_BUCKET=waiter-documents

# --- JWT (Supabase Auth) ---
# Тот же JWT_SECRET, что лежит в ~/supabase/docker/.env
# Без него токены не пройдут проверку в GoTrue / PostgREST.
SUPABASE_JWT_SECRET=
# Опционально (значения по умолчанию совпадают со стандартным Supabase)
# JWT_ACCESS_TTL_SEC=3600
# JWT_AUD=authenticated
# JWT_ISSUER=                 # пусто = "<SUPABASE_WAITER_URL>/auth/v1"

# --- SMS (коды + поведение) ---
# SMS_CODE_TTL_SEC=300          # 5 минут
# SMS_RESEND_COOLDOWN_SEC=60    # повторная отправка не чаще 1/мин
# SMS_MAX_ATTEMPTS=5            # неверных вводов до блокировки кода

# --- OCR распознавание паспорта ---
OCR_API_URL=https://api.ocr.ads-soft.ru/recognition
OCR_TOKEN=

# --- n8n webhook для отправки SMS-кода ---
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# --- Web Push (вызов официанта — доставка при свёрнутом приложении) ---
# Сгенерировать: npx web-push generate-vapid-keys
# Публичный ключ не секрет — дублируется во фронте как VITE_VAPID_PUBLIC_KEY.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Контакт для push-сервисов Apple/Google на случай проблем с отправками.
VAPID_SUBJECT=mailto:admin@example.ru
