# ============================================================
# waiter-api — серверные секреты. НИКОГДА не попадают в браузер.
# Скопируй в server/.env и заполни РОТИРОВАННЫМИ значениями.
# ============================================================

# Порт, на котором слушает сервис
PORT=8080

# Разрешённые источники (домены фронта), через запятую.
# Прод-пример: https://waiter.example.ru
# Если оставить пустым — разрешаются любые (только для локальной разработки!)
CORS_ORIGIN=

# --- Supabase (база официантов) ---
SUPABASE_WAITER_URL=
# SERVICE ROLE KEY — обходит RLS. Только здесь, на сервере!
SUPABASE_WAITER_SERVICE_KEY=
# Бакет для документов официантов
WAITER_DOCUMENTS_BUCKET=waiter-documents

# --- OCR распознавание паспорта ---
OCR_API_URL=https://api.ocr.ads-soft.ru/recognition
OCR_TOKEN=

# --- n8n webhook для отправки SMS-кода ---
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
