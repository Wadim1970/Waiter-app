# ============================================================
# Waiter-app — переменные фронта.
# ВСЁ отсюда попадает в браузерный бандл и видно любому.
# СЕКРЕТЫ СЮДА КЛАСТЬ НЕЛЬЗЯ — они живут в server/.env
# ============================================================

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_WAITER_URL=
VITE_SUPABASE_WAITER_ANON_KEY=
VITE_APP_URL=

# Адрес бэкенда waiter-api (он держит service-key, OCR-токен, webhook-секрет)
VITE_API_URL=http://localhost:8080

# Публичный VAPID-ключ для push-подписки (не секрет — приватный живёт
# только в server/.env). Должен совпадать с VAPID_PUBLIC_KEY на сервере.
VITE_VAPID_PUBLIC_KEY=

# ── ПЕРЕНЕСЕНО НА СЕРВЕР, во фронте больше НЕ используется: ──
#   VITE_SUPABASE_WAITER_SERVICE_KEY  → server: SUPABASE_WAITER_SERVICE_KEY
#   VITE_OCR_TOKEN                    → server: OCR_TOKEN
#   VITE_WEBHOOK_URL                  → server: N8N_WEBHOOK_URL
#   VITE_WEBHOOK_SECRET               → server: N8N_WEBHOOK_SECRET
